DISCORD_TOKEN=your_discord_bot_token_here

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_REDACTION_MODEL=google/gemini-2.5-flash
OPENROUTER_RAGEBAIT_MODEL=x-ai/grok-4.1-fast
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=discord-bot-webcam

WEBCAM_AUDIO_DEVICE=plughw:CARD=Device,DEV=0
WEBCAM_AUDIO_DURATION_SECONDS=10
WEBCAM_CAPTURE_TIMEOUT_SECONDS=20

REMOTE_WEBCAM_SSH_TARGET=root@laptop3
REMOTE_WEBCAM_DEVICE=/dev/video0
REMOTE_WEBCAM_OUTPUT=/tmp/discord-remote-webcam.jpg
REMOTE_WEBCAM_TIMEOUT_SECONDS=12
REMOTE_WEBCAM_WARMUP_FRAMES=30
REMOTE_WEBCAM_WARMUP_FPS=15
REMOTE_WEBCAM_SETTLE_SECONDS=0.4

WEBCAM_REDACTION_TIMEOUT_SECONDS=30
WEBCAM_REDACTION_MAX_SIDE=1280
WEBCAM_REDACTION_PADDING_RATIO=0.08
WEBCAM_REDACTION_MIN_BOX_SIDE=12
WEBCAM_REDACTION_PROTECT_TIMESTAMP=true
WEBCAM_REDACTION_FAIL_CLOSED=true

RAGEBAIT_START_HISTORY_LIMIT=60
RAGEBAIT_MAX_TURNS=40
RAGEBAIT_MAX_DURATION_SECONDS=1800
RAGEBAIT_IDLE_TIMEOUT_SECONDS=300
RAGEBAIT_MO_BELIEFS_PATH=/app/mo_beliefs.json
MO_USER_ID=your_discord_user_id_here
